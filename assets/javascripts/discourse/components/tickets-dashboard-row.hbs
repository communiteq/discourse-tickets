<div class="directory-table__cell directory-table__cell--title">
  <a title="{{this.ticket.title}}" href="{{this.ticket.url}}">{{this.ticket.title}}</a>
</div>
<div class="directory-table__cell directory-table__cell--tags">
  {{#each this.ticket.tags as |t|}}
    <a {{action this.filterBy 'tag' t}}>
      {{discourse-tag t noHref=true}}
    </a>
  {{/each}}
</div>
<div class="directory-table__cell directory-table__cell--status">{{this.ticket.status}}</div>
<div class="directory-table__cell directory-table__cell--priority">{{this.ticket.priority}}</div>
<div class="directory-table__cell directory-table__cell--reason">{{this.ticket.reason}}</div>
<div class="directory-table__cell directory-table__cell--assigned">
  {{#if this.ticket.assigned}}
    {{tickets-dashboard-user user=this.ticket.assigned.user
                             filterBy=this.filterBy}}
  {{/if}}
</div>
