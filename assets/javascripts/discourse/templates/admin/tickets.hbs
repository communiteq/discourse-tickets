<div class="tickets-filters">
  <div class="controls">
    {{combo-box
      content=this.filterFields
      value=this.filterField
      none='tickets.dashboard_table.filter.field'
    }}
    {{combo-box
      content=this.filterValues
      value=this.filterValue
      none='tickets.dashboard_table.filter.value'
    }}
    {{d-button action=(action "applyFilter") label='tickets.dashboard_table.filter.apply'}}
  </div>
  <div class="filters">
    {{#each this.currentFilters as |filter|}}
      <div class="filter">
        <span>{{filter.field}}: {{filter.value}}</span>
        {{d-button action=(action "removeFilter") actionParam=filter icon='times'}}
      </div>
    {{/each}}
  </div>
</div>

<div class="tickets-pages">
  <span class="label">{{i18n 'tickets.dashboard_table.page.label'}}</span>
  <div class="count">
    {{#if this.lessThanLimit}}
      {{this.total}}
    {{else}}
      {{this.pageStart}} - {{this.pageEnd}} of {{this.total}}
    {{/if}}
  </div>
  <div class="controls">
    {{d-button action=(action "previousPage") label='tickets.dashboard_table.page.previous'disabled=this.previousDisabled}}
    {{d-button action=(action "nextPage") label='tickets.dashboard_table.page.next' disabled=this.nextDisabled}}
  </div>
  <div class="page-list">
    {{#each this.pages as |p|}}
      {{d-button translatedLabel=p.number action=(action "goToPage") actionParam=p.number class=p.classes}}
    {{/each}}
  </div>
</div>

{{#conditional-loading-spinner condition=this.refreshing}}
  <table class='grid'>
    <thead>
      {{table-header-toggle tagName="th" field="title" labelKey='tickets.dashboard_table.headings.title' order=this.order asc=this.asc automatic=true}}
      {{table-header-toggle tagName="th" field="tags" labelKey='tagging.tags' order=this.order asc=this.asc automatic=true}}
      {{table-header-toggle tagName="th" field="status" labelKey='tickets.status' order=this.order asc=this.asc automatic=true}}
      {{table-header-toggle tagName="th" field="priority" labelKey='tickets.priority' order=this.order asc=this.asc automatic=true}}
      {{table-header-toggle tagName="th" field="reason" labelKey="tickets.reason" order=this.order asc=this.asc automatic=true}}
      {{table-header-toggle tagName="th" field="assigned" labelKey="tickets.dashboard_table.headings.assigned" order=this.order asc=this.asc automatic=true}}
    </thead>
    <tbody>
      {{#each this.tickets as |ticket|}}
        {{tickets-dashboard-row ticket=ticket
                                filterBy=(action 'filterBy')}}
      {{/each}}
    </tbody>
  </table>
{{/conditional-loading-spinner}}
