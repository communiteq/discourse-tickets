<div class="tickets-filters">
  <div class="controls">
    {{combo-box
      content=this.filterFields
      value=this.filterField
      none='tickets.dashboard_table.filter.field'
    }}
    {{combo-box
      content=this.filterValues
      value=this.filterValue
      none='tickets.dashboard_table.filter.value'
    }}
    {{d-button action=(action "applyFilter") label='tickets.dashboard_table.filter.apply'}}
  </div>
  <div class="filters">
    {{#each this.currentFilters as |filter|}}
      <div class="filter">
        <span class="filter-field">
          {{filter.field}}: {{filter.value}}
          {{d-button action=(action "removeFilter") actionParam=filter class="btn-transparent remove-filter" icon='xmark'}}
        </span>
      </div>
    {{/each}}
  </div>
</div>

<div class="tickets-pages">
  <span class="label">{{i18n 'tickets.dashboard_table.page.label'}}</span>
  <div class="count">
    {{#if this.lessThanLimit}}
      {{this.total}}
    {{else}}
      {{this.pageStart}} - {{this.pageEnd}} of {{this.total}}
    {{/if}}
  </div>
  <div class="controls">
    {{d-button action=(action "previousPage") label='tickets.dashboard_table.page.previous'disabled=this.previousDisabled}}
    {{d-button action=(action "nextPage") label='tickets.dashboard_table.page.next' disabled=this.nextDisabled}}
  </div>
  <div class="page-list">
    {{#each this.pages as |p|}}
      {{d-button translatedLabel=p.number action=(action "goToPage") actionParam=p.number class=p.classes}}
    {{/each}}
  </div>
</div>

<ConditionalLoadingSpinner @condition={{@this.refreshing}} />
{{#unless @this.refreshing}}
 <ResponsiveTable @className="tickets-grid">
    <:header>
      <TableHeaderToggle @field="title" @labelKey='tickets.dashboard_table.headings.title' @order=this.order @asc=this.asc @automatic=true />
      <TableHeaderToggle @field="tags" @labelKey='tagging.tags' @order=this.order @asc=this.asc @automatic=true />
      <TableHeaderToggle @field="status" @labelKey='tickets.status' @order=this.order @asc=this.asc @automatic=true />
      <TableHeaderToggle @field="priority" @labelKey='tickets.priority' @order=this.order @asc=this.asc @automatic=true />
      <TableHeaderToggle @field="reason" @labelKey="tickets.reason" @order=this.order @asc=this.asc @automatic=true />
      <TableHeaderToggle @field="assigned" @labelKey="tickets.dashboard_table.headings.assigned" @order=this.order @asc=this.asc @automatic=true />
    </:header>
    <:body>
      {{#each this.tickets as |ticket|}}
          {{tickets-dashboard-row ticket=ticket filterBy=(action 'filterBy')}}
      {{/each}}
    </:body>
  </<ResponsiveTable>
{{/unless}}
